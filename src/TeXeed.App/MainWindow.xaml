<Window x:Class="TeXeed.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:TeXeed.App.Controls" Title="TeXeed" Style="{StaticResource {x:Type Window}}" Width="1440" Height="920" MinWidth="1050" MinHeight="640" WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" PreviewMouseDown="Window_PreviewMouseDown" Deactivated="Window_Deactivated" AllowDrop="True" Drop="Window_Drop">
 <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Menu x:Name="MainMenu" Visibility="Collapsed" Background="#FAFBF8" Padding="12,2">
   <MenuItem x:Name="FirstMenuItem" Header="文件(_F)"><MenuItem Header="新建文档…" InputGestureText="Ctrl+N" Click="New_Click"/><MenuItem Header="打开主文件…" InputGestureText="Ctrl+O" Click="Open_Click"/><MenuItem x:Name="RecentMenu" Header="最近打开"/><Separator/><MenuItem Header="保存并编译" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="重新加载项目" Click="Refresh_Click"/><MenuItem Header="导出 PDF…" Click="Export_Click"/><Separator/><MenuItem Header="退出" Click="Exit_Click"/></MenuItem>
   <MenuItem Header="编辑(_E)"><MenuItem Header="查找" InputGestureText="Ctrl+F" Tag="find" Click="EditorCommand_Click"/><MenuItem Header="替换" InputGestureText="Ctrl+H" Tag="replace" Click="EditorCommand_Click"/><MenuItem Header="切换注释" InputGestureText="Ctrl+/" Tag="comment" Click="EditorCommand_Click"/><MenuItem Header="增加缩进" Tag="indent" Click="EditorCommand_Click"/><MenuItem Header="减少缩进" Tag="outdent" Click="EditorCommand_Click"/><MenuItem Header="格式化文档" InputGestureText="Ctrl+Shift+F" Tag="format" Click="EditorCommand_Click"/></MenuItem>
   <MenuItem Header="视图(_V)"><MenuItem x:Name="WorkspaceVisibilityMenuItem" Header="工作区" IsCheckable="True" IsChecked="True" InputGestureText="Ctrl+B" Click="ToggleWorkspace_Click"/></MenuItem>
   <MenuItem Header="排版(_B)"><MenuItem Header="编译文档" InputGestureText="Ctrl+Enter" Click="Build_Click"/><MenuItem x:Name="CancelBuildMenuItem" Header="停止编译" IsEnabled="False" Click="Cancel_Click"/><MenuItem Header="定位到 PDF" InputGestureText="Ctrl+J" Click="Sync_Click"/><Separator/><MenuItem x:Name="LiveMenuItem" Header="实时预览" IsCheckable="True" ToolTip="修改后自动保存并编译" Click="Live_Click"/><MenuItem Header="设置…" Click="Settings_Click"/></MenuItem>
   <MenuItem Header="帮助(_H)"><MenuItem Header="快捷键与使用说明" Click="Help_Click"/><MenuItem Header="关于 TeXeed" Click="About_Click"/></MenuItem>
  </Menu>
  <Grid Grid.Row="1" x:Name="Workspace" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="252" MinWidth="200"/><ColumnDefinition x:Name="SidebarSplitterColumn" Width="5"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="5"/><ColumnDefinition Width="0.95*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Border x:Name="SidebarPanel" Background="#F3F5F0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="18,0,8,0"><Button x:Name="CollapseWorkspaceButton" Content="‹" FontSize="20" Padding="6,0" Margin="0" Height="28" DockPanel.Dock="Right" VerticalAlignment="Center" ToolTip="折叠工作区 (Ctrl+B)" AutomationProperties.Name="折叠工作区" Click="ToggleWorkspace_Click"/><TextBlock Text="工作区" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <UniformGrid Grid.Row="1" Columns="5" Margin="7,0,7,5">
      <Button Content="大纲" Padding="2,6" Margin="1" Tag="outline" Click="SidebarMode_Click"/>
      <Button Content="文件" Padding="2,6" Margin="1" Tag="files" Click="SidebarMode_Click"/>
      <Button Content="搜索" Padding="2,6" Margin="1" Tag="search" Click="SidebarMode_Click"/>
      <Button Content="标签" Padding="2,6" Margin="1" Tag="labels" Click="SidebarMode_Click"/>
      <Button Content="待办" Padding="2,6" Margin="1" Tag="todos" Click="SidebarMode_Click"/>
     </UniformGrid>
     <StackPanel Grid.Row="2" Margin="14,10,14,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="SidebarTitle" Text="文档大纲" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding Visibility, ElementName=OutlineTree}">
        <Button x:Name="ExpandOutlineButton" Content="全部展开" FontSize="11" Padding="4,2" Margin="2,0,0,0" MinHeight="24" Click="ExpandOutline_Click" ToolTip="展开所有层级的标题"/>
        <Button x:Name="CollapseOutlineButton" Content="全部折叠" FontSize="11" Padding="4,2" Margin="2,0,0,0" MinHeight="24" Click="CollapseOutline_Click" ToolTip="折叠所有层级，只显示顶层标题"/>
       </StackPanel>
      </Grid>
      <TextBox x:Name="SearchBox" Margin="0,10,0,0" Visibility="Collapsed" TextChanged="Search_Changed" ToolTip="搜索项目中的文字或标签"/>
     </StackPanel>
     <Grid Grid.Row="3"><controls:DocumentOutline x:Name="OutlineTree" NavigateRequested="Outline_NavigateRequested"/><TreeView x:Name="FileTree" Background="Transparent" BorderThickness="0" Margin="8" Visibility="Collapsed" SelectedItemChanged="FileTree_Selected"/><ListBox x:Name="IndexList" SelectionChanged="Index_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/><TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyIndex" Text="暂无条目" Margin="18,15" Foreground="{StaticResource Muted}" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
     <TextBlock Grid.Row="4" x:Name="ProjectSummary" Margin="16" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    </Grid>
   </Border>
   <Border x:Name="CollapsedWorkspaceRail" Visibility="Collapsed" Background="#F3F5F0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Button x:Name="ExpandWorkspaceButton" Content="›" FontSize="20" Padding="2,0" Margin="2,7" Height="28" VerticalAlignment="Top" ToolTip="展开工作区 (Ctrl+B)" AutomationProperties.Name="展开工作区" Click="ToggleWorkspace_Click"/></Border>
   <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Grid Grid.Column="2" Background="White">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="#F9FAF7"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="FileTabs" Orientation="Horizontal"/></ScrollViewer></Border>
    <DockPanel Grid.Row="1" Margin="14,0"><TextBlock x:Name="FileCaption" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="LaTeX" FontSize="11" Foreground="#97A39C" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
    <controls:LatexEditor x:Name="Editor" Grid.Row="2"/>
    <Expander x:Name="LogExpander" Grid.Row="3" Header="编译输出" Background="#F5F7F3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" MaxHeight="260">
     <TabControl Background="#F5F7F3" BorderThickness="0" Height="205"><TabItem Header="问题"><ListBox x:Name="DiagnosticsList" SelectionChanged="Diagnostic_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Line, StringFormat=行 {0}}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem><TabItem Header="完整日志"><TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem></TabControl>
    </Expander>
   </Grid>
   <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#E2E8E2"/>
   <Grid Grid.Column="4" Background="#E8ECE7">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Border Background="#F9FAF7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><DockPanel Margin="8,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="−" Padding="8,2" Margin="2,5" Click="ZoomOut_Click"/><Button x:Name="ZoomButton" Content="适合宽度" Padding="7,2" Margin="2,5" Click="Fit_Click"/><Button Content="+" Padding="8,2" Margin="2,5" Click="ZoomIn_Click"/><Button Content="导出" Padding="8,2" Margin="2,5" Click="Export_Click"/></StackPanel><ComboBox x:Name="FollowModeBox" Width="92" HorizontalAlignment="Left" Margin="2,6,4,6" Padding="4,0" FontSize="12" VerticalContentAlignment="Center" DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="PDF 跟随模式：不跟随、跟随光标或跟随视图。Ctrl+J 始终可手动定位到光标。" AutomationProperties.Name="PDF 跟随模式" SelectionChanged="FollowMode_Changed"/></DockPanel></Border>
    <controls:PdfPreview x:Name="Preview" Grid.Row="1"/>
    <DockPanel Grid.Row="2" Margin="12,0"><TextBlock x:Name="PdfStatus" Text="等待首次编译" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="右键双击 → 源码" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
   </Grid>
  </Grid>
  <Grid Grid.Row="1" x:Name="Welcome">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="90,40,40,40" MaxWidth="470" HorizontalAlignment="Left"><TextBlock Text="A LITTLE SPACE FOR BIG IDEAS" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="写作，&#x0a;从这里开始。" FontSize="46" FontWeight="Light" LineHeight="64" Margin="0,20,0,20"/><TextBlock Text="让结构、公式与灵感自然相遇。&#x0a;打开主 TeX 文件，即可进入完整的写作工作区。" FontSize="15" Foreground="{StaticResource Muted}" LineHeight="26"/><StackPanel Orientation="Horizontal" Margin="0,30,0,0"><Button Content="打开 LaTeX 项目" Padding="20,12" Style="{StaticResource PrimaryButton}" Click="Open_Click"/><Button Content="新建文档" Padding="20,12" Margin="12,0,0,0" Click="New_Click"/></StackPanel><TextBlock Text="也可以将 .tex 文件拖入窗口" FontSize="12" Foreground="{StaticResource Muted}" Margin="3,18,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="#F0F3EC" CornerRadius="16" Margin="25,65,80,65" Padding="34" MaxWidth="450" VerticalAlignment="Center">
    <StackPanel><TextBlock Text="你的下一篇，正在酝酿" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="原生 Windows 工作区 · 为 LaTeX 而设计" Foreground="{StaticResource Muted}" Margin="0,10,0,24"/><Border Background="#FFFFFF" Padding="24" CornerRadius="8"><StackPanel><TextBlock Text="\section{A new beginning}" FontFamily="Consolas" Foreground="{StaticResource Accent}" FontSize="14"/><TextBlock Text="Every idea deserves a little space." FontFamily="Consolas" FontSize="13" Margin="0,12,0,0"/><TextBlock Text="E = mc²" FontFamily="Cambria Math" FontSize="30" HorizontalAlignment="Center" Margin="0,28,0,18"/></StackPanel></Border><TextBlock Text="最近打开" FontSize="12" FontWeight="SemiBold" Margin="0,28,0,8"/><StackPanel x:Name="RecentList"/><TextBlock x:Name="NoRecent" Text="打开第一份文档，开始积累你的想法。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#EFF3EC" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><DockPanel Margin="14,0"><TextBlock x:Name="CursorStatus" Text="UTF-8  ·  LaTeX" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="Alt 菜单" DockPanel.Dock="Right" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" ToolTip="按 Alt 显示或隐藏主菜单"/><TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</Window>
