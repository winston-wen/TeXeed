<Window x:Class="TeXeed.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:TeXeed.App.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="TeXeed" Style="{StaticResource {x:Type Window}}" Width="1440" Height="920" MinWidth="280" MinHeight="320" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" PreviewMouseDown="Window_PreviewMouseDown" Deactivated="Window_Deactivated" AllowDrop="True" Drop="Window_Drop">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspaceIcons.xaml"/><ResourceDictionary Source="TitleBar.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid x:Name="WindowRoot" ClipToBounds="True" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
  <Grid.RowDefinitions><RowDefinition x:Name="TitleBarRow" Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" PreviewMouseRightButtonUp="TitleBar_RightButtonUp">
   <Grid Margin="6,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button x:Name="CompactMenuButton" Visibility="Collapsed" Style="{StaticResource TitleIconButton}" Width="36" ToolTip="主菜单 (Alt)" AutomationProperties.Name="主菜单" Click="CompactMenu_Click"><Path Width="18" Height="14" Stretch="Fill" Data="M0,1 H18 M0,7 H18 M0,13 H18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
  <Menu x:Name="MainMenu" IsMainMenu="False" Background="Transparent" Padding="0" FontSize="14" VerticalAlignment="Stretch"><Menu.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Height" Value="39"/><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style></Menu.ItemContainerStyle>
   <MenuItem x:Name="FirstMenuItem" Header="文件(_F)"><MenuItem Header="新建文档…" InputGestureText="Ctrl+N" Click="New_Click"/><MenuItem Header="打开主文件…" InputGestureText="Ctrl+O" Click="Open_Click"/><MenuItem x:Name="RecentMenu" Header="最近打开"/><Separator/><MenuItem Header="保存并编译" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="重新加载项目" Click="Refresh_Click"/><MenuItem Header="导出 PDF…" Click="Export_Click"/><Separator/><MenuItem Header="退出" Click="Exit_Click"/></MenuItem>
   <MenuItem Header="编辑(_E)"><MenuItem Header="查找" InputGestureText="Ctrl+F" Tag="find" Click="EditorCommand_Click"/><MenuItem Header="替换" InputGestureText="Ctrl+H" Tag="replace" Click="EditorCommand_Click"/><MenuItem Header="切换注释" InputGestureText="Ctrl+/" Tag="comment" Click="EditorCommand_Click"/><MenuItem Header="增加缩进" Tag="indent" Click="EditorCommand_Click"/><MenuItem Header="减少缩进" Tag="outdent" Click="EditorCommand_Click"/><MenuItem Header="格式化文档" InputGestureText="Ctrl+Shift+F" Tag="format" Click="EditorCommand_Click"/></MenuItem>
   <MenuItem Header="视图(_V)"><MenuItem x:Name="ThemeMenu" Header="主题" SubmenuOpened="ThemeMenu_Opened"/><MenuItem x:Name="WordWrapMenuItem" Header="自动换行" IsCheckable="True" InputGestureText="Alt+Z" Click="WordWrap_Click"/><MenuItem x:Name="WorkspaceVisibilityMenuItem" Header="工作区" IsCheckable="True" IsChecked="True" InputGestureText="Ctrl+B" Click="ToggleWorkspace_Click"/><MenuItem x:Name="FullscreenMenuItem" Header="全屏" IsCheckable="True" InputGestureText="F11" Click="Fullscreen_Click"/></MenuItem>
   <MenuItem Header="排版(_B)"><MenuItem Header="编译文档" InputGestureText="Ctrl+Enter" Click="Build_Click"/><MenuItem x:Name="CancelBuildMenuItem" Header="停止编译" IsEnabled="False" Click="Cancel_Click"/><MenuItem Header="定位到 PDF" InputGestureText="Ctrl+J" Click="Sync_Click"/><Separator/><MenuItem x:Name="LiveMenuItem" Header="实时预览" IsCheckable="True" ToolTip="修改后自动保存并编译" Click="Live_Click"/><MenuItem Header="设置…" Click="Settings_Click"/></MenuItem>
   <MenuItem x:Name="AiMenuItem" Header="AI(_A)" Click="Ai_Click"/>
   <MenuItem Header="帮助(_H)"><MenuItem Header="快捷键与使用说明" Click="Help_Click"/><MenuItem Header="关于 TeXeed" Click="About_Click"/></MenuItem>
  </Menu>
    </Grid>
    <TextBlock x:Name="CaptionTitle" Grid.Column="2" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
    <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" ToolTip="最小化" AutomationProperties.Name="最小化" Click="Minimize_Click"><Path Width="10" Height="1" Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/></Button>
     <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" ToolTip="最大化" AutomationProperties.Name="最大化" Click="Maximize_Click"><Path x:Name="MaximizeGlyph" Width="11" Height="11" Data="M0.5,0.5 H10.5 V10.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/></Button>
     <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" ToolTip="关闭" AutomationProperties.Name="关闭" Click="CloseCaption_Click"><Path Width="11" Height="11" Data="M0.5,0.5 L10.5,10.5 M10.5,0.5 L0.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" x:Name="Workspace" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="294" MinWidth="242"/><ColumnDefinition x:Name="SidebarSplitterColumn" Width="2"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="2"/><ColumnDefinition Width="0.95*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Grid x:Name="SidebarHost"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="WorkspaceRail" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">     <UniformGrid x:Name="WorkspaceIconBar" Columns="1" Margin="3" VerticalAlignment="Top">
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceOutlineIcon}" Tag="outline" ToolTip="大纲" AutomationProperties.Name="大纲" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceFilesIcon}" Tag="files" ToolTip="文件" AutomationProperties.Name="文件" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceSearchIcon}" Tag="search" ToolTip="搜索" AutomationProperties.Name="搜索" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceBookmarksIcon}" Tag="bookmarks" ToolTip="书签" AutomationProperties.Name="书签" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceLabelsIcon}" Tag="labels" ToolTip="标签" AutomationProperties.Name="标签" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceTodosIcon}" Tag="todos" ToolTip="待办" AutomationProperties.Name="待办" Click="SidebarMode_Click"/>
     </UniformGrid></Border>
   <Border Grid.Column="1" x:Name="SidebarPanel" controls:ScrollActivity.IsScope="True" Background="{DynamicResource SidebarBackground}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

     <StackPanel Margin="14,10,14,8">
      <Grid Height="26"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="SidebarTitle" Text="文档大纲" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       <StackPanel x:Name="SidebarTreeActions" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
        <Button x:Name="ExpandAllButton" Style="{StaticResource SidebarActionButton}" Content="{StaticResource ExpandAllIcon}" ToolTip="全部展开" AutomationProperties.Name="全部展开" Click="ExpandAll_Click"/>
        <Button x:Name="CollapseAllButton" Style="{StaticResource SidebarActionButton}" Content="{StaticResource CollapseAllIcon}" ToolTip="全部收起" AutomationProperties.Name="全部收起" Click="CollapseAll_Click"/>
       </StackPanel>
      </Grid>
      <TextBox x:Name="SearchBox" Margin="0,10,0,0" Visibility="Collapsed" TextChanged="Search_Changed" ToolTip="搜索项目中的文字或标签"/>
      <Grid x:Name="BookmarkSearchPanel" Margin="0,8,0,0" Visibility="Collapsed">
       <TextBox x:Name="BookmarkSearchBox" Padding="25,5,25,5" FontSize="12" TextChanged="BookmarkSearch_Changed" PreviewKeyDown="BookmarkSearch_KeyDown" ToolTip="按书签标题或目标标识搜索；Esc 清空" AutomationProperties.Name="搜索书签"/>
       <Path Data="{StaticResource WorkspaceSearchIcon}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
       <TextBlock Text="搜索书签…" Foreground="{DynamicResource Muted}" FontSize="12" Margin="26,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=BookmarkSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <Button Content="{StaticResource ClearSearchIcon}" HorizontalAlignment="Right" ToolTip="清空书签搜索" AutomationProperties.Name="清空书签搜索" Click="ClearBookmarkSearch_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarActionButton}"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="24"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=BookmarkSearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </Grid>
      <Grid x:Name="FileSearchPanel" Margin="0,8,0,0" Visibility="Collapsed">
       <TextBox x:Name="FileSearchBox" Padding="25,5,25,5" FontSize="12" TextChanged="FileSearch_Changed" PreviewKeyDown="FileSearch_KeyDown" ToolTip="按文件名筛选，不区分大小写；Esc 清空" AutomationProperties.Name="搜索文件名"/>
       <Path Data="{StaticResource WorkspaceSearchIcon}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
       <TextBlock Text="搜索文件名…" Foreground="{DynamicResource Muted}" FontSize="12" Margin="26,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FileSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <Button Content="{StaticResource ClearSearchIcon}" HorizontalAlignment="Right" ToolTip="清空文件名搜索" AutomationProperties.Name="清空文件名搜索" Click="ClearFileSearch_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarActionButton}"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="24"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FileSearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </Grid>
     </StackPanel>
     <Grid Grid.Row="1"><controls:DocumentOutline x:Name="OutlineTree" NavigateRequested="Outline_NavigateRequested"/><controls:DocumentOutline x:Name="BookmarkTree" JoinFiles="True" ShowLevelBadges="False" Visibility="Collapsed" NavigateRequested="Outline_NavigateRequested"/><TreeView x:Name="FileTree" Background="Transparent" BorderThickness="0" Margin="8" Visibility="Collapsed" SelectedItemChanged="FileTree_Selected" PreviewMouseLeftButtonUp="FileTree_LeftUp" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/><ListBox x:Name="IndexList" SelectionChanged="Index_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/><TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyIndex" Text="暂无条目" Margin="18,15" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
    </Grid>
   </Border>
   </Grid>
   <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}"/>
   <Grid x:Name="EditorPane" controls:ScrollActivity.IsScope="True" Grid.Column="2" Background="{DynamicResource EditorBackground}">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="{DynamicResource SidebarBackground}"><controls:EditorTabStrip x:Name="FileTabs"/></Border>
    <Grid x:Name="LeftGroupBody" Grid.Row="1">
     <Grid x:Name="LeftSourceView"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <controls:LatexEditor x:Name="LeftEditor" Grid.Row="0"/>
    <TextBlock x:Name="NoOpenFile" Grid.Row="0" Visibility="Collapsed" Text="从左侧选择文件继续编辑" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Expander x:Name="LogExpander" Grid.Row="1" Header="编译输出" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" MaxHeight="260">
     <Expander.Template><ControlTemplate TargetType="Expander"><Border x:Name="LogBody" Visibility="Collapsed" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="LogBody" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Expander.Template>
     <TabControl x:Name="LogTabs" controls:ScrollActivity.IsScope="True" Background="{DynamicResource SidebarBackground}" BorderThickness="0" Padding="0" Height="205">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource PanelBackground}"><TabPanel IsItemsHost="True"/></Border><ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Grid></ControlTemplate></TabControl.Template>
      <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabChrome" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource SidebarBackground}"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources><TabItem Header="问题"><ListBox x:Name="DiagnosticsList" Padding="0" Margin="0" BorderThickness="0" SelectionChanged="Diagnostic_Selected"><ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer Padding="0" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Line, StringFormat=行 {0}}" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem><TabItem Header="完整日志"><TextBox x:Name="LogText" Padding="10,8,0,8" Margin="0" IsReadOnly="True" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/></ControlTemplate></TextBox.Template></TextBox></TabItem></TabControl>
    </Expander>
    <Border x:Name="EditorStatusBar" Grid.Row="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
     <DockPanel Margin="10,0">
      <TextBlock x:Name="CursorStatus" Text="行 1，列 1  ·  LaTeX" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/>
      <ToggleButton x:Name="LogToggle" IsChecked="{Binding IsExpanded, ElementName=LogExpander, Mode=TwoWay}" ToolTip="显示或隐藏编译输出" AutomationProperties.Name="编译输出" Foreground="{DynamicResource Muted}" MinWidth="0">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="StatusChrome" Background="Transparent" Padding="0,2"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusChrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
       <DockPanel><TextBlock x:Name="LogToggleHint" DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="⌃ 展开输出"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=LogExpander}" Value="True"><Setter Property="Text" Value="⌄ 收起输出"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock x:Name="StatusText" Text="就绪" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel>
      </ToggleButton>
     </DockPanel>
    </Border>

     </Grid>
    </Grid>
   </Grid>
   <GridSplitter x:Name="PreviewSplitter" Grid.Column="3" Style="{StaticResource PaneSplitter}"/>
   <Grid x:Name="PreviewPane" controls:ScrollActivity.IsScope="True" Grid.Column="4" Background="{DynamicResource EditorBackground}">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="{DynamicResource SidebarBackground}"><controls:EditorTabStrip x:Name="RightFileTabs"/></Border>
    <Grid x:Name="RightGroupBody" Grid.Row="1">
     <Grid x:Name="RightSourceView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <controls:LatexEditor x:Name="RightEditor"/>
      <Border x:Name="RightEditorStatusBar" Grid.Row="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel Margin="10,0">
       <TextBlock x:Name="RightCursorStatus" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
       <ToggleButton IsChecked="{Binding IsExpanded, ElementName=LogExpander, Mode=TwoWay}" Click="RightLog_Click" ToolTip="编译输出" Foreground="{DynamicResource Muted}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="{Binding Text, ElementName=StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
      </DockPanel></Border>
     </Grid>
     <Grid x:Name="PreviewContent" Background="{DynamicResource PreviewBackground}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <controls:PdfPreview x:Name="Preview"/>
      <Border x:Name="PreviewStatusBar" Grid.Row="1" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><TextBlock x:Name="PdfStatus" Text="等待首次编译" Margin="12,0" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="右键双击或 Ctrl+左键返回源码；预览设置在标签齿轮中"/></Border>
     </Grid>
    </Grid>
   </Grid>
   <Canvas x:Name="DockDropOverlay" Grid.Column="2" Grid.ColumnSpan="3" Panel.ZIndex="100" IsHitTestVisible="False"><Border x:Name="DockDropCue" Visibility="Collapsed" Background="{DynamicResource Accent}" Opacity="0.18" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="4"/></Canvas>
  </Grid>
  <Grid Grid.Row="1" x:Name="Welcome">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="90,40,40,40" MaxWidth="470" HorizontalAlignment="Left"><TextBlock Text="A LITTLE SPACE FOR BIG IDEAS" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/><TextBlock Text="写作，&#x0a;从这里开始。" FontSize="46" FontWeight="Light" LineHeight="64" Margin="0,20,0,20"/><TextBlock Text="让结构、公式与灵感自然相遇。&#x0a;打开主 TeX 文件，即可进入完整的写作工作区。" FontSize="15" Foreground="{DynamicResource Muted}" LineHeight="26"/><StackPanel Orientation="Horizontal" Margin="0,30,0,0"><Button Content="打开 LaTeX 项目" Padding="20,12" Style="{StaticResource PrimaryButton}" Click="Open_Click"/><Button Content="新建文档" Padding="20,12" Margin="12,0,0,0" Click="New_Click"/></StackPanel><TextBlock Text="也可以将 .tex 文件拖入窗口" FontSize="12" Foreground="{DynamicResource Muted}" Margin="3,18,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="{DynamicResource SidebarBackground}" CornerRadius="16" Margin="25,65,80,65" Padding="34" MaxWidth="450" VerticalAlignment="Center">
    <StackPanel><TextBlock Text="你的下一篇，正在酝酿" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="原生 Windows 工作区 · 为 LaTeX 而设计" Foreground="{DynamicResource Muted}" Margin="0,10,0,24"/><Border Background="{DynamicResource EditorBackground}" Padding="24" CornerRadius="8"><StackPanel><TextBlock Text="\section{A new beginning}" FontFamily="Consolas" Foreground="{DynamicResource Accent}" FontSize="14"/><TextBlock Text="Every idea deserves a little space." FontFamily="Consolas" FontSize="13" Margin="0,12,0,0"/><TextBlock Text="E = mc²" FontFamily="Cambria Math" FontSize="30" HorizontalAlignment="Center" Margin="0,28,0,18"/></StackPanel></Border><TextBlock Text="最近打开" FontSize="12" FontWeight="SemiBold" Margin="0,28,0,8"/><StackPanel x:Name="RecentList"/><TextBlock x:Name="NoRecent" Text="打开第一份文档，开始积累你的想法。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
   </Border>
  </Grid>
  <Border x:Name="FullscreenToast" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,54,0,0" Padding="20,10" CornerRadius="6" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><TextBlock x:Name="FullscreenToastText" Foreground="{DynamicResource Ink}"/></Border>
 </Grid>
</Window>
