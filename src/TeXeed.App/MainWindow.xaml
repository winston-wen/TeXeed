<Window x:Class="TeXeed.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:TeXeed.App.Controls" Title="TeXeed" Style="{StaticResource {x:Type Window}}" Width="1440" Height="920" MinWidth="1050" MinHeight="640" WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" PreviewMouseDown="Window_PreviewMouseDown" Deactivated="Window_Deactivated" AllowDrop="True" Drop="Window_Drop">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspaceIcons.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Menu x:Name="MainMenu" Visibility="Collapsed" Background="{DynamicResource EditorBackground}" Padding="12,2">
   <MenuItem x:Name="FirstMenuItem" Header="文件(_F)"><MenuItem Header="新建文档…" InputGestureText="Ctrl+N" Click="New_Click"/><MenuItem Header="打开主文件…" InputGestureText="Ctrl+O" Click="Open_Click"/><MenuItem x:Name="RecentMenu" Header="最近打开"/><Separator/><MenuItem Header="保存并编译" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="重新加载项目" Click="Refresh_Click"/><MenuItem Header="导出 PDF…" Click="Export_Click"/><Separator/><MenuItem Header="退出" Click="Exit_Click"/></MenuItem>
   <MenuItem Header="编辑(_E)"><MenuItem Header="查找" InputGestureText="Ctrl+F" Tag="find" Click="EditorCommand_Click"/><MenuItem Header="替换" InputGestureText="Ctrl+H" Tag="replace" Click="EditorCommand_Click"/><MenuItem Header="切换注释" InputGestureText="Ctrl+/" Tag="comment" Click="EditorCommand_Click"/><MenuItem Header="增加缩进" Tag="indent" Click="EditorCommand_Click"/><MenuItem Header="减少缩进" Tag="outdent" Click="EditorCommand_Click"/><MenuItem Header="格式化文档" InputGestureText="Ctrl+Shift+F" Tag="format" Click="EditorCommand_Click"/></MenuItem>
   <MenuItem Header="视图(_V)"><MenuItem x:Name="ThemeMenu" Header="主题" SubmenuOpened="ThemeMenu_Opened"/><MenuItem x:Name="WorkspaceVisibilityMenuItem" Header="工作区" IsCheckable="True" IsChecked="True" InputGestureText="Ctrl+B" Click="ToggleWorkspace_Click"/></MenuItem>
   <MenuItem Header="排版(_B)"><MenuItem Header="编译文档" InputGestureText="Ctrl+Enter" Click="Build_Click"/><MenuItem x:Name="CancelBuildMenuItem" Header="停止编译" IsEnabled="False" Click="Cancel_Click"/><MenuItem Header="定位到 PDF" InputGestureText="Ctrl+J" Click="Sync_Click"/><Separator/><MenuItem x:Name="LiveMenuItem" Header="实时预览" IsCheckable="True" ToolTip="修改后自动保存并编译" Click="Live_Click"/><MenuItem Header="设置…" Click="Settings_Click"/></MenuItem>
   <MenuItem Header="帮助(_H)"><MenuItem Header="快捷键与使用说明" Click="Help_Click"/><MenuItem Header="关于 TeXeed" Click="About_Click"/></MenuItem>
  </Menu>
  <Grid Grid.Row="1" x:Name="Workspace" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="252" MinWidth="200"/><ColumnDefinition x:Name="SidebarSplitterColumn" Width="5"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="5"/><ColumnDefinition Width="0.95*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Border x:Name="SidebarPanel" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <UniformGrid x:Name="WorkspaceIconBar" Columns="6" Margin="5,3">
      <Button x:Name="CollapseWorkspaceButton" Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceCollapseIcon}" ToolTip="折叠工作区 (Ctrl+B)" AutomationProperties.Name="折叠工作区" Click="ToggleWorkspace_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceOutlineIcon}" Tag="outline" ToolTip="大纲" AutomationProperties.Name="大纲" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceFilesIcon}" Tag="files" ToolTip="文件" AutomationProperties.Name="文件" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceSearchIcon}" Tag="search" ToolTip="搜索" AutomationProperties.Name="搜索" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceLabelsIcon}" Tag="labels" ToolTip="标签" AutomationProperties.Name="标签" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceTodosIcon}" Tag="todos" ToolTip="待办" AutomationProperties.Name="待办" Click="SidebarMode_Click"/>
     </UniformGrid>
     <StackPanel Grid.Row="1" Margin="14,10,14,8">
      <Grid Height="26"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="SidebarTitle" Text="文档大纲" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding Visibility, ElementName=OutlineTree}">
        <Button x:Name="ExpandOutlineButton" Style="{StaticResource OutlineActionButton}" Content="{StaticResource OutlineExpandAllIcon}" Width="26" Height="26" Margin="2,0,0,0" Click="ExpandOutline_Click" ToolTip="全部展开" AutomationProperties.Name="全部展开大纲"/>
        <Button x:Name="CollapseOutlineButton" Style="{StaticResource OutlineActionButton}" Content="{StaticResource OutlineCollapseAllIcon}" Width="26" Height="26" Margin="2,0,0,0" Click="CollapseOutline_Click" ToolTip="全部收起" AutomationProperties.Name="全部收起大纲"/>
       </StackPanel>
      </Grid>
      <TextBox x:Name="SearchBox" Margin="0,10,0,0" Visibility="Collapsed" TextChanged="Search_Changed" ToolTip="搜索项目中的文字或标签"/>
     </StackPanel>
     <Grid Grid.Row="2"><controls:DocumentOutline x:Name="OutlineTree" NavigateRequested="Outline_NavigateRequested"/><TreeView x:Name="FileTree" Background="Transparent" BorderThickness="0" Margin="8" Visibility="Collapsed" SelectedItemChanged="FileTree_Selected"/><ListBox x:Name="IndexList" SelectionChanged="Index_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/><TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyIndex" Text="暂无条目" Margin="18,15" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
    </Grid>
   </Border>
   <Border x:Name="CollapsedWorkspaceRail" Visibility="Collapsed" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
    <UniformGrid x:Name="WorkspaceRailIcons" Columns="1" Margin="3" VerticalAlignment="Top">
      <Button x:Name="ExpandWorkspaceButton" Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceExpandIcon}" ToolTip="展开工作区 (Ctrl+B)" AutomationProperties.Name="展开工作区" Click="ToggleWorkspace_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceOutlineIcon}" Tag="outline" ToolTip="大纲" AutomationProperties.Name="大纲" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceFilesIcon}" Tag="files" ToolTip="文件" AutomationProperties.Name="文件" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceSearchIcon}" Tag="search" ToolTip="搜索" AutomationProperties.Name="搜索" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceLabelsIcon}" Tag="labels" ToolTip="标签" AutomationProperties.Name="标签" Click="SidebarMode_Click"/>
      <Button Style="{StaticResource WorkspaceIconButton}" Content="{StaticResource WorkspaceTodosIcon}" Tag="todos" ToolTip="待办" AutomationProperties.Name="待办" Click="SidebarMode_Click"/>
    </UniformGrid>
   </Border>
   <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Grid x:Name="EditorPane" Grid.Column="2" Background="{DynamicResource EditorBackground}">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="{DynamicResource SidebarBackground}"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="FileTabs" Orientation="Horizontal"/></ScrollViewer></Border>
    <controls:LatexEditor x:Name="Editor" Grid.Row="1"/>
    <Expander x:Name="LogExpander" Grid.Row="2" Header="编译输出" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" MaxHeight="260">
     <Expander.Template><ControlTemplate TargetType="Expander"><Border x:Name="LogBody" Visibility="Collapsed" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="LogBody" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Expander.Template>
     <TabControl Background="{DynamicResource SidebarBackground}" BorderThickness="0" Height="205"><TabItem Header="问题"><ListBox x:Name="DiagnosticsList" SelectionChanged="Diagnostic_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Line, StringFormat=行 {0}}" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem><TabItem Header="完整日志"><TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem></TabControl>
    </Expander>
    <Border x:Name="EditorStatusBar" Grid.Row="3" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
     <DockPanel Margin="10,0">
      <TextBlock x:Name="CursorStatus" Text="行 1，列 1  ·  LaTeX" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/>
      <ToggleButton x:Name="LogToggle" IsChecked="{Binding IsExpanded, ElementName=LogExpander, Mode=TwoWay}" ToolTip="显示或隐藏编译输出" AutomationProperties.Name="编译输出" Foreground="{DynamicResource Muted}" MinWidth="0">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="StatusChrome" Background="Transparent" Padding="0,2"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusChrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
       <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" TextTrimming="CharacterEllipsis"/>
      </ToggleButton>
     </DockPanel>
    </Border>
   </Grid>
   <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{DynamicResource PanelBackground}"/>
   <Grid x:Name="PreviewPane" Grid.Column="4" Background="{DynamicResource PreviewBackground}">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><DockPanel Margin="8,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="−" Padding="8,2" Margin="2,5" Click="ZoomOut_Click"/><Button x:Name="ZoomButton" Content="适合宽度" Padding="7,2" Margin="2,5" Click="Fit_Click"/><Button Content="+" Padding="8,2" Margin="2,5" Click="ZoomIn_Click"/><Button Content="导出" Padding="8,2" Margin="2,5" Click="Export_Click"/></StackPanel><ComboBox x:Name="FollowModeBox" Width="92" HorizontalAlignment="Left" Margin="2,6,4,6" Padding="4,0" FontSize="12" VerticalContentAlignment="Center" DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="PDF 跟随模式：不跟随、跟随光标或跟随视图。Ctrl+J 始终可手动定位到光标。" AutomationProperties.Name="PDF 跟随模式" SelectionChanged="FollowMode_Changed"/></DockPanel></Border>
    <controls:PdfPreview x:Name="Preview" Grid.Row="1"/>
    <Border x:Name="PreviewStatusBar" Grid.Row="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel Margin="12,0"><CheckBox x:Name="InvertPdfBox" Content="反色" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11" ToolTip="反转 PDF 预览颜色：暖棕黑纸张、柔和米白文字，内容同步映射为深色配色；导出 PDF 保持原色。" AutomationProperties.Name="PDF 反色" Click="InvertPdf_Click"/><CheckBox x:Name="AutoCropPdfBox" Content="裁边" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11" ToolTip="自动裁掉四周空白、压缩页内大段纵向空白，按内容适合宽度连续滚动；导出保持完整页面。" AutomationProperties.Name="PDF 自动裁边" Click="AutoCropPdf_Click"/><TextBlock x:Name="PdfStatus" ToolTip="右键双击或 Ctrl+左键返回源码" Text="等待首次编译" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="1" x:Name="Welcome">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="90,40,40,40" MaxWidth="470" HorizontalAlignment="Left"><TextBlock Text="A LITTLE SPACE FOR BIG IDEAS" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/><TextBlock Text="写作，&#x0a;从这里开始。" FontSize="46" FontWeight="Light" LineHeight="64" Margin="0,20,0,20"/><TextBlock Text="让结构、公式与灵感自然相遇。&#x0a;打开主 TeX 文件，即可进入完整的写作工作区。" FontSize="15" Foreground="{DynamicResource Muted}" LineHeight="26"/><StackPanel Orientation="Horizontal" Margin="0,30,0,0"><Button Content="打开 LaTeX 项目" Padding="20,12" Style="{StaticResource PrimaryButton}" Click="Open_Click"/><Button Content="新建文档" Padding="20,12" Margin="12,0,0,0" Click="New_Click"/></StackPanel><TextBlock Text="也可以将 .tex 文件拖入窗口" FontSize="12" Foreground="{DynamicResource Muted}" Margin="3,18,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="{DynamicResource SidebarBackground}" CornerRadius="16" Margin="25,65,80,65" Padding="34" MaxWidth="450" VerticalAlignment="Center">
    <StackPanel><TextBlock Text="你的下一篇，正在酝酿" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="原生 Windows 工作区 · 为 LaTeX 而设计" Foreground="{DynamicResource Muted}" Margin="0,10,0,24"/><Border Background="{DynamicResource EditorBackground}" Padding="24" CornerRadius="8"><StackPanel><TextBlock Text="\section{A new beginning}" FontFamily="Consolas" Foreground="{DynamicResource Accent}" FontSize="14"/><TextBlock Text="Every idea deserves a little space." FontFamily="Consolas" FontSize="13" Margin="0,12,0,0"/><TextBlock Text="E = mc²" FontFamily="Cambria Math" FontSize="30" HorizontalAlignment="Center" Margin="0,28,0,18"/></StackPanel></Border><TextBlock Text="最近打开" FontSize="12" FontWeight="SemiBold" Margin="0,28,0,8"/><StackPanel x:Name="RecentList"/><TextBlock x:Name="NoRecent" Text="打开第一份文档，开始积累你的想法。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
