<UserControl x:Class="TeXeed.App.Controls.AiPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{DynamicResource EditorBackground}" Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8">
   <DockPanel><Button DockPanel.Dock="Right" Content="设置" Click="Settings_Click" Padding="6,3"/><Button x:Name="HistoryButton" DockPanel.Dock="Right" Content="历史" Click="History_Click" Padding="6,3"/><Button x:Name="NewConversationButton" DockPanel.Dock="Right" Content="＋" Click="NewConversation_Click" Padding="6,3" ToolTip="新对话"/><Button DockPanel.Dock="Right" Content="⌕" Click="FindMessage_Click" Padding="6,3" ToolTip="查找当前对话"/><TextBlock x:Name="ConversationTitle" Text="新对话" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
   <TextBlock x:Name="ConnectionLabel" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
  <DockPanel x:Name="MessageSearchPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="↓" Click="NextMatch_Click" Padding="5,3"/><Button DockPanel.Dock="Right" Content="↑" Click="PreviousMatch_Click" Padding="5,3"/><TextBlock x:Name="MessageMatchStatus" DockPanel.Dock="Right" Text="0" VerticalAlignment="Center" Margin="6,0"/><TextBox x:Name="MessageSearchBox" TextChanged="MessageSearch_Changed" ToolTip="查找问题和回答" AutomationProperties.Name="查找当前 AI 对话"/></DockPanel>
  <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <StackPanel x:Name="EmptyConversation" Margin="12,45,12,35"><TextBlock Text="AI 对话" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="从一个问题，或一处圈点开始。" Foreground="{DynamicResource Muted}" Margin="0,12" HorizontalAlignment="Center"/><TextBlock Text="在源码或 PDF 中右键开启 AI 圈点。单击标记点位，按住选择内容；松开即添加到下方编辑栏。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" MaxWidth="360"/></StackPanel>
    <ItemsControl x:Name="History"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,24">
     <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="DeleteTurn_Click" Padding="5,1" ToolTip="删除此轮问题和回答"/><TextBlock Text="{Binding DisplayTime}" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/></DockPanel>
     <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="12" Margin="24,0,0,12"><TextBlock Text="{Binding DisplayQuestion}" TextWrapping="Wrap"/></Border>
     <TextBox Text="{Binding DisplayAnswer, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent" Padding="2"/>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel x:Name="LiveContainer" Visibility="Collapsed"><Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="12" Margin="24,0,0,12"><TextBlock x:Name="LiveQuestion" TextWrapping="Wrap"/></Border><TextBox x:Name="Transcript" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent" Padding="2"/></StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Border x:Name="ComposerBorder" Grid.Row="3" BorderBrush="{DynamicResource Guide}" BorderThickness="1" Background="{DynamicResource SidebarBackground}" CornerRadius="10" Padding="10" Margin="0,10,0,0">
   <StackPanel>
    <Expander x:Name="ContextExpander" Header="圈点与问题条目" IsExpanded="True" Visibility="Collapsed">
     <ScrollViewer x:Name="ContextScroll" MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Entries"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="2,4" Margin="0,0,0,4"><StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="×" Padding="6,0" Click="Remove_Click" ToolTip="移除此条目"/><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Click="Entry_Changed" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/></DockPanel>
        <Expander Header="查看上下文"><StackPanel>
         <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding File}" TextWrapping="Wrap"/><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <ItemsControl ItemsSource="{Binding PdfBlocks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Page, StringFormat=PDF 第 {0} 页}"/><Image Loaded="Thumbnail_Loaded" Stretch="Uniform" MaxHeight="140"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Text="{Binding State}" Foreground="{DynamicResource Muted}"/>
        </StackPanel></Expander>
        <TextBox Text="{Binding Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Question_Changed" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80" ToolTip="对此处的单独说明（可留空，使用下方统一问题）"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </Expander>
    <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" MaxHeight="150" Padding="8,8" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" TextChanged="Composer_Changed" PreviewKeyDown="Composer_KeyDown" ToolTip="描述问题；Enter 发送，Shift+Enter 换行" AutomationProperties.Name="AI 对话编辑栏"/>
    <Grid x:Name="ModelControls" Margin="0,4,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="ModelPicker" SelectionChanged="ChatModel_Changed" ToolTip="选择模型" AutomationProperties.Name="AI 对话模型" MinWidth="70"/>
     <ComboBox x:Name="EffortPicker" Grid.Column="1" SelectionChanged="ChatEffort_Changed" ToolTip="推理强度" AutomationProperties.Name="AI 推理强度" Margin="5,0,0,0"/>
     <Button Grid.Column="2" Content="↻" Click="RefreshModels_Click" Padding="5,3" ToolTip="刷新可用模型"/>
    </Grid>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" MaxHeight="48" Margin="0,4,0,8" Text="输入问题；Enter 发送，Shift+Enter 换行。" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <DockPanel><Button x:Name="SubmitButton" DockPanel.Dock="Right" Content="↑ 发送" Click="Submit_Click" ToolTip="提交输入内容和勾选条目" Padding="6,4"/><Button x:Name="StopButton" DockPanel.Dock="Right" Content="停止" Click="Stop_Click" IsEnabled="False" Padding="6,4"/><WrapPanel><Button Content="＋" Click="Add_Click" Padding="6,4" ToolTip="添加条目"/><Button Content="✓" Click="SelectAll_Click" Padding="6,4" ToolTip="全选条目"/><Button Content="清理" Click="ClearDone_Click" Padding="6,4" ToolTip="清理已完成条目"/></WrapPanel></DockPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
