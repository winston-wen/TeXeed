<UserControl x:Class="TeXeed.App.Controls.AiPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TeXeed.App.Controls">
 <UserControl.Resources>
  <Style x:Key="ChatIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
  </Style>
  <Style x:Key="QuestionText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="15"/>
  </Style>
  <Style x:Key="ComposerIcon" TargetType="Button" BasedOn="{StaticResource ChatIcon}">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="SegmentTemplate">
   <StackPanel x:Name="SegmentRow" Margin="0,0,0,14">
    <Border x:Name="Activity" Background="{DynamicResource ChatQuestionBackground}" CornerRadius="4" BorderBrush="{DynamicResource Guide}" BorderThickness="2,0,0,0" Padding="8,2" Visibility="Collapsed">
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DisplayTime}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="17"/></DockPanel>
    </Border>
    <TextBlock x:Name="FinalLabel" Text="答复" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,8" Visibility="Collapsed"/>
    <local:MarkdownView x:Name="Content" Markdown="{Binding Text}"/>
   </StackPanel>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="activity"><Setter TargetName="SegmentRow" Property="Margin" Value="0,0,0,7"/><Setter TargetName="Activity" Property="Visibility" Value="Visible"/><Setter TargetName="Content" Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="final"><Setter TargetName="FinalLabel" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Background="{DynamicResource EditorBackground}" Margin="20,14,14,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="ChatSettingsButton" Style="{StaticResource ChatIcon}" Click="Settings_Click" ToolTip="AI 设置" AutomationProperties.Name="AI 设置"><Path Width="19" Height="19" Stretch="Uniform" Data="M6,1 L8,1 8.5,3 10,4 12,3.5 13,5.5 11.5,7 11.5,9 13,10.5 12,12.5 10,12 8.5,13 8,15 6,15 5.5,13 4,12 2,12.5 1,10.5 2.5,9 2.5,7 1,5.5 2,3.5 4,4 5.5,3 Z M9.5,8 A2.5,2.5 0 1 1 4.5,8 A2.5,2.5 0 1 1 9.5,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
     <Button Style="{StaticResource ChatIcon}" Click="FindMessage_Click" ToolTip="查找当前对话 · Ctrl+F" AutomationProperties.Name="查找当前对话"><Path Data="M 8,1 A 7,7 0 1 0 8,15 A 7,7 0 1 0 8,1 M 13,13 L 19,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
     <Button x:Name="HistoryButton" Style="{StaticResource ChatIcon}" Click="History_Click" ToolTip="历史对话" AutomationProperties.Name="历史对话"><Path Data="M 10,1 A 9,9 0 1 0 10,19 A 9,9 0 1 0 10,1 M 10,4 V 10 L 14,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
     <Button x:Name="NewConversationButton" Style="{StaticResource ChatIcon}" Click="NewConversation_Click" ToolTip="新对话" AutomationProperties.Name="新对话"><Path Data="M 2,15 A 9,9 0 1 1 7,19 L 1,20 Z M 10,5 V 13 M 6,9 H 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
    </StackPanel>
    <TextBlock x:Name="ConversationTitle" Text="新对话" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
   </DockPanel>
   <TextBlock x:Name="ConnectionLabel" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
  </StackPanel>  <DockPanel x:Name="MessageSearchPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="↓" Click="NextMatch_Click" Padding="5,3"/><Button DockPanel.Dock="Right" Content="↑" Click="PreviousMatch_Click" Padding="5,3"/><TextBlock x:Name="MessageMatchStatus" DockPanel.Dock="Right" Text="0" VerticalAlignment="Center" Margin="6,0"/><TextBox x:Name="MessageSearchBox" TextChanged="MessageSearch_Changed" ToolTip="查找问题和回答" AutomationProperties.Name="查找当前 AI 对话"/></DockPanel>
  <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <StackPanel x:Name="EmptyConversation" Margin="12,45,12,35"><TextBlock Text="AI 对话" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="从一个问题，或一处圈点开始。" Foreground="{DynamicResource Muted}" Margin="0,12" HorizontalAlignment="Center"/><TextBlock Text="在源码或 PDF 中右键开启 AI 圈点。单击标记点位，按住选择内容；松开即添加到下方编辑栏。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" MaxWidth="360"/></StackPanel>
    <ItemsControl x:Name="History" Margin="0,8,8,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,30">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,3"><Button Content="↶" Click="RetryTurn_Click" BorderThickness="0" Padding="5,1" Foreground="{DynamicResource Muted}" ToolTip="将问题重新放入编辑栏"/><Button Content="×" Click="DeleteTurn_Click" BorderThickness="0" Padding="5,1" Foreground="{DynamicResource Muted}" ToolTip="删除此轮问题和回答"/></StackPanel>
     <Border Background="{DynamicResource ChatQuestionBackground}" CornerRadius="12" Padding="14,12" Margin="0,0,0,12"><StackPanel><TextBox Text="{Binding DisplayQuestion, Mode=OneWay}" Style="{StaticResource QuestionText}"/><TextBlock Text="{Binding DisplayTime}" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" Margin="0,7,0,0"/></StackPanel></Border>
     <ItemsControl ItemsSource="{Binding DisplaySegments}" ItemTemplate="{StaticResource SegmentTemplate}" Margin="12,0,4,0"/>
     <TextBlock Text="{Binding AnswerTime}" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" Margin="12,0,4,0"/>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel x:Name="LiveContainer" Visibility="Collapsed" Margin="0,8,8,20">
     <Border Background="{DynamicResource ChatQuestionBackground}" CornerRadius="12" Padding="14,12" Margin="0,0,0,12"><StackPanel><TextBox x:Name="LiveQuestion" Style="{StaticResource QuestionText}"/><TextBlock x:Name="LiveSentTime" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" Margin="0,7,0,0"/></StackPanel></Border>
     <ItemsControl x:Name="LiveSegments" ItemTemplate="{StaticResource SegmentTemplate}" Margin="12,0,4,0"/>
    </StackPanel>   </StackPanel>
  </ScrollViewer>
  <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" MaxHeight="44" Margin="6,4,8,0" Text="" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <Border x:Name="ComposerBorder" Grid.Row="4" BorderThickness="1.5" Background="{DynamicResource ChatQuestionBackground}" CornerRadius="15" Padding="10" Margin="0,16,6,0">
   <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Guide}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ChatFocus}"/></Trigger></Style.Triggers></Style></Border.Style>
   <StackPanel>
    <Expander x:Name="ContextExpander" Header="圈点与问题条目" IsExpanded="True" Visibility="Collapsed">
     <ScrollViewer x:Name="ContextScroll" MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Entries"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="2,4" Margin="0,0,0,4"><StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="×" Padding="6,0" Click="Remove_Click" ToolTip="移除此条目"/><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Click="Entry_Changed" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/></DockPanel>
        <Expander Header="查看上下文"><StackPanel>
         <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding File}" TextWrapping="Wrap"/><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <ItemsControl ItemsSource="{Binding PdfBlocks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Page, StringFormat=PDF 第 {0} 页}"/><Image Loaded="Thumbnail_Loaded" Stretch="Uniform" MaxHeight="140"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Text="{Binding State}" Foreground="{DynamicResource Muted}"/>
        </StackPanel></Expander>
        <TextBox Text="{Binding Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Question_Changed" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="80" ToolTip="对此处的单独说明（可留空，使用下方统一问题）"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </Expander>
    <Grid>
     <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" MaxHeight="150" Padding="8,8" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" TextChanged="Composer_Changed" PreviewKeyDown="Composer_KeyDown" FontSize="15" ToolTip="Enter / Shift+Enter 换行；Ctrl+Enter 发送" AutomationProperties.Name="AI 对话编辑栏"/>
     <TextBlock Text="写下问题，继续探索…" Foreground="{DynamicResource Muted}" FontSize="15" Margin="8,8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Composer}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="-10,6,-10,0" Padding="8,9,8,0">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="AddButton" Click="Options_Click" Style="{StaticResource ComposerIcon}" ToolTip="添加圈点与对话操作" Margin="0,0,8,0" AutomationProperties.Name="添加圈点与对话操作">
       <Path Data="M 8,1 V 15 M 1,8 H 15" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Button.ContextMenu><ContextMenu><MenuItem Header="添加圈点说明" Click="Add_Click"/><MenuItem Header="全选圈点" Click="SelectAll_Click"/><MenuItem Header="清理已完成圈点" Click="ClearDone_Click"/><Separator/><MenuItem Header="刷新模型" Click="RefreshModels_Click"/><MenuItem Header="AI 设置" Click="Settings_Click"/></ContextMenu></Button.ContextMenu>
      </Button>
      <ComboBox x:Name="PermissionPicker" Grid.Column="1" SelectionChanged="Permission_Changed" AutomationProperties.Name="会话权限" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"/>
      <Grid x:Name="ModelControls" Grid.Column="3" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="ContextUsageText" Text="—" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,7,0" VerticalAlignment="Center" AutomationProperties.Name="上下文使用百分比"/>
       <ComboBox x:Name="ModelPicker" Grid.Column="1" SelectionChanged="ChatModel_Changed" ToolTip="选择模型" AutomationProperties.Name="AI 对话模型" MinWidth="90" MaxWidth="190" BorderThickness="0" Background="{DynamicResource PanelBackground}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
       <ComboBox x:Name="EffortPicker" Grid.Column="2" SelectionChanged="ChatEffort_Changed" ToolTip="推理强度" AutomationProperties.Name="AI 推理强度" Margin="5,0,0,0" BorderThickness="0" Background="Transparent"/>
      </Grid>
      <Grid x:Name="SendControls" Grid.Column="4" Margin="8,0,0,0">
       <Button x:Name="SubmitButton" Click="Submit_Click" ToolTip="发送 · Ctrl+Enter" AutomationProperties.Name="发送问题" Background="{DynamicResource ChatFocus}" Foreground="White"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ComposerIcon}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style><Path Data="M 8,15 V 1 M 2,7 L 8,1 14,7" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
       <Button x:Name="StopButton" Click="Stop_Click" ToolTip="停止回答" AutomationProperties.Name="停止回答" Background="{DynamicResource ChatFocus}" IsEnabled="False"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ComposerIcon}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style><Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="White"/></Button>
      </Grid>
     </Grid>
    </Border>
   </StackPanel>
  </Border>
  <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=HistoryButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
   <Border Width="{Binding ActualWidth, ElementName=MessagesScroll}" MaxWidth="620" MinWidth="230" Padding="14" CornerRadius="16" Background="{DynamicResource ChatQuestionBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <StackPanel>
     <DockPanel Margin="6,6,6,14"><TextBlock Text="⌕" FontSize="23" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/><Grid>
      <TextBox x:Name="HistorySearchBox" TextChanged="HistorySearch_Changed" BorderThickness="0" Background="Transparent" FontSize="16" Padding="2,5" ToolTip="搜索对话…" AutomationProperties.Name="搜索历史对话"/>
      <TextBlock Text="搜索对话…" Foreground="{DynamicResource Muted}" FontSize="16" Margin="2,5" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid></DockPanel>
     <TextBlock x:Name="HistoryEmpty" Text="没有匹配的对话" Foreground="{DynamicResource Muted}" Margin="8"/>
     <ListBox x:Name="HistoryList" MaxHeight="340" PreviewKeyDown="HistoryList_KeyDown" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="9" Background="Transparent" Padding="10,10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><DockPanel>
       <Button DockPanel.Dock="Right" Content="×" Click="HistoryDelete_Click" BorderThickness="0" Padding="4,0" ToolTip="删除对话" Foreground="{DynamicResource Muted}"/>
       <TextBlock DockPanel.Dock="Right" Text="{Binding RelativeTime}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0"/>
       <Button Content="{Binding Title}" Click="HistoryOpen_Click" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"><Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/></Border></ControlTemplate></Button.Template></Button>
      </DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
