<UserControl x:Class="TeXeed.App.Controls.AiPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TeXeed.App.Controls" xmlns:ai="clr-namespace:TeXeed.App.AI">
 <UserControl.Resources>
  <Style x:Key="ChatIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
  </Style>
  <Style x:Key="QuestionText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="15"/>
  </Style>
  <Style x:Key="ComposerIcon" TargetType="Button" BasedOn="{StaticResource ChatIcon}">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ActivityExpander" TargetType="Expander">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><DockPanel><Path x:Name="Arrow" Data="M0,0 L3,3 0,6" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5"/><ContentPresenter/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger><DataTrigger Binding="{Binding Details}" Value=""><Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/><Setter Property="IsEnabled" Value="False"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="SegmentTemplate">
   <StackPanel x:Name="SegmentRow" Margin="0,0,0,14">
    <Border x:Name="Activity" Background="{DynamicResource ChatQuestionBackground}" CornerRadius="4" BorderBrush="{DynamicResource Guide}" BorderThickness="2,0,0,0" Padding="8,2" Visibility="Collapsed">
     <Expander Style="{StaticResource ActivityExpander}" HorizontalContentAlignment="Stretch"><Expander.Header><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Right" Text="{Binding DisplayTime}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="17"/></DockPanel></Expander.Header><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Code, Consolas" FontSize="12" Background="{DynamicResource EditorBackground}" TextWrapping="Wrap" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,6,0,4"/></Expander>
    </Border>
    <local:MarkdownView x:Name="Content" IsStreaming="True" Markdown="{Binding Text}" Loaded="Answer_Loaded" Unloaded="Answer_Unloaded"/>
   </StackPanel>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="activity"><Setter TargetName="SegmentRow" Property="Margin" Value="0,0,0,7"/><Setter TargetName="Activity" Property="Visibility" Value="Visible"/><Setter TargetName="Content" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Background="{DynamicResource EditorBackground}" Margin="20,0,14,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel x:Name="MessageSearchPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="↓" Click="NextMatch_Click" Padding="5,3"/><Button DockPanel.Dock="Right" Content="↑" Click="PreviousMatch_Click" Padding="5,3"/><TextBlock x:Name="MessageMatchStatus" DockPanel.Dock="Right" Text="0" VerticalAlignment="Center" Margin="6,0"/><TextBox x:Name="MessageSearchBox" TextChanged="MessageSearch_Changed" ToolTip="查找问题和回答" AutomationProperties.Name="查找当前 AI 对话"/></DockPanel>
  <Grid Grid.Row="1" ClipToBounds="True">
  <!-- Reserve a stable gutter: first overflow must not reflow every rich document. -->
   <ItemsControl x:Name="History" Margin="0,8,8,0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0" VirtualizingPanel.VirtualizationMode="Standard">
    <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer x:Name="MessagesScroll" CanContentScroll="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="MessagesScroll_Wheel"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:ChatVirtualizingPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.Resources><DataTemplate DataType="{x:Type ai:AiTurn}"><local:AiTurnView Turn="{Binding}" Loaded="Turn_Loaded" Margin="0,0,0,30"/></DataTemplate></ItemsControl.Resources>
    <StackPanel x:Name="EmptyConversation" Margin="12,45,12,35"><TextBlock Text="AI 对话" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="从一个问题，或一处圈点开始。" Foreground="{DynamicResource Muted}" Margin="0,12" HorizontalAlignment="Center"/><TextBlock Text="点击左边栏 AI 圈点按钮，再在源码、PDF 或 AI 回答中选择。松开后就地填写批注，点击编号气泡可继续编辑。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" MaxWidth="360"/></StackPanel>
    <StackPanel x:Name="LiveContainer" Visibility="Collapsed" Margin="0,8,0,30">
     <local:MarkdownView x:Name="LiveQuestion" Padding="12,8,12,0"/><TextBlock x:Name="LiveSentTime" Foreground="{DynamicResource Muted}" FontFamily="Consolas, Microsoft YaHei" FontSize="11" TextWrapping="Wrap" Margin="12,4,4,8"/>
     <ItemsControl x:Name="LiveSegments" ItemTemplate="{StaticResource SegmentTemplate}" Margin="12,0,4,0"/>
     <local:AiReplyStatus x:Name="LiveReplyStatus" IsThinking="True" Margin="12,14,4,0"/>
    </StackPanel>
   </ItemsControl>
   <Border x:Name="ReadingContext" VerticalAlignment="Top" Panel.ZIndex="1" Visibility="Collapsed" BorderBrush="{DynamicResource ChatDivider}" BorderThickness="0,0,0,2" Background="{DynamicResource ChatQuestionBackground}" Padding="12,6" ClipToBounds="True"><StackPanel>
    <TextBlock x:Name="ReadingContextTitle" FontFamily="Cascadia Code, Consolas, Microsoft YaHei" FontSize="12" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="ReadingContextAnnotations" FontFamily="Cascadia Code, Consolas, Microsoft YaHei" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
   </StackPanel></Border>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" MaxHeight="44" Margin="6,4,8,0" Text="" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <Border x:Name="ComposerBorder" Grid.Row="3" BorderThickness="1.5" Background="{DynamicResource ChatQuestionBackground}" CornerRadius="0" Padding="0" Margin="0,8,0,0">
   <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Guide}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ChatFocus}"/></Trigger></Style.Triggers></Style></Border.Style>
   <StackPanel>
    <Grid x:Name="ComposerEditor"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ComposerLines" Text="1" Foreground="{DynamicResource Muted}" FontFamily="Consolas, Microsoft YaHei" Margin="4,8,0,0" FontSize="15" IsHitTestVisible="False"/>
     <TextBox Grid.Column="1" x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" MaxHeight="150" Padding="8,8" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" TextChanged="Composer_Changed" PreviewKeyDown="Composer_KeyDown" FontFamily="Cascadia Code, Consolas, Microsoft YaHei" FontSize="15" AcceptsTab="True" ToolTip="Enter / Shift+Enter 换行；Ctrl+Enter 发送" AutomationProperties.Name="AI 对话编辑栏"/>

    </Grid>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0" Padding="2" x:Name="ComposerToolbar">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="AddButton" Click="Options_Click" Style="{StaticResource ComposerIcon}" ToolTip="添加圈点与对话操作" Margin="0,0,8,0" AutomationProperties.Name="添加圈点与对话操作">
       <Path Data="M 8,1 V 15 M 1,8 H 15" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Button.ContextMenu><ContextMenu><MenuItem Header="添加圈点说明" Click="Add_Click"/><MenuItem Header="全选圈点" Click="SelectAll_Click"/><MenuItem Header="清理已完成圈点" Click="ClearDone_Click"/><Separator/><MenuItem Header="刷新模型" Click="RefreshModels_Click"/><MenuItem Header="AI 设置" Click="Settings_Click"/></ContextMenu></Button.ContextMenu>
      </Button>
      <ComboBox x:Name="PermissionPicker" Height="28" Grid.Column="1" SelectionChanged="Permission_Changed" AutomationProperties.Name="会话权限" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"/>
      <Button x:Name="EntriesButton" Height="28" Grid.Column="2" Content="圈点 · 0" Click="Entries_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0" Padding="5,3"/>
      <Grid x:Name="ModelControls" Grid.Column="3" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="ContextUsageText" Text="—" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,7,0" VerticalAlignment="Center" AutomationProperties.Name="上下文使用百分比"/>
       <ComboBox x:Name="ModelPicker" Height="28" Grid.Column="1" SelectionChanged="ChatModel_Changed" ToolTip="选择模型" AutomationProperties.Name="AI 对话模型" MinWidth="90" MaxWidth="190" BorderThickness="0" Background="{DynamicResource PanelBackground}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
       <ComboBox x:Name="EffortPicker" Height="28" Grid.Column="2" SelectionChanged="ChatEffort_Changed" ToolTip="推理强度" AutomationProperties.Name="AI 推理强度" Margin="5,0,0,0" BorderThickness="0" Background="Transparent"/>
      </Grid>
      <Grid x:Name="SendControls" Grid.Column="4" Margin="8,0,0,0">
       <Button x:Name="SubmitButton" Click="Submit_Click" ToolTip="发送 · Ctrl+Enter" AutomationProperties.Name="发送问题" Background="{DynamicResource ChatFocus}" Foreground="White"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ComposerIcon}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style><Path Data="M 8,15 V 1 M 2,7 L 8,1 14,7" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
       <Button x:Name="StopButton" Click="Stop_Click" ToolTip="停止回答" AutomationProperties.Name="停止回答" Background="{DynamicResource ChatFocus}" IsEnabled="False"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ComposerIcon}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style><Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="White"/></Button>
      </Grid>
     </Grid>
    </Border>
   </StackPanel>
  </Border>
  <Popup x:Name="EntriesPopup" PlacementTarget="{Binding ElementName=EntriesButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True"><Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Guide}" BorderThickness="1" CornerRadius="10" Padding="12" Width="430"><StackPanel><Button Content="完成" Click="CloseEntries_Click" HorizontalAlignment="Right"/>
    <Expander x:Name="ContextExpander" Header="圈点与问题条目" IsExpanded="True" Visibility="Collapsed">
     <ScrollViewer x:Name="ContextScroll" MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Entries"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="2,4" Margin="0,0,0,4"><StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="×" Padding="6,0" Click="Remove_Click" ToolTip="移除此条目"/><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Click="Entry_Changed" VerticalAlignment="Center"/><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/></DockPanel>
        <Expander Header="查看上下文"><StackPanel>
         <TextBlock Text="{Binding AnswerAnchor.Quote}" TextWrapping="Wrap" MaxHeight="140"/>
         <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding File}" TextWrapping="Wrap"/><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <ItemsControl ItemsSource="{Binding PdfBlocks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Page, StringFormat=PDF 第 {0} 页}"/><Image Loaded="Thumbnail_Loaded" Stretch="Uniform" MaxHeight="140"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Text="{Binding State}" Foreground="{DynamicResource Muted}"/>
        </StackPanel></Expander>
        <TextBox Text="{Binding Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Question_Changed" PreviewKeyDown="Entry_KeyDown" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, Microsoft YaHei" AcceptsTab="True" MaxHeight="140" ToolTip="对此处的单独说明（可留空，使用下方统一问题）"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </Expander>
  </StackPanel></Border></Popup>

 </Grid>
</UserControl>
