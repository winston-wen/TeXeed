<UserControl x:Class="TeXeed.App.Controls.AiPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{DynamicResource EditorBackground}" Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Expander Header="连接与模型" x:Name="ConnectionPanel" IsExpanded="True">
   <StackPanel Margin="0,8">
    <WrapPanel><Button Content="Continue with ChatGPT" Click="Login_Click" ToolTip="使用系统浏览器登录 ChatGPT"/><Button Content="添加账号" Click="AddAccount_Click"/><Button Content="退出" Click="Logout_Click"/></WrapPanel>
    <ComboBox x:Name="Accounts" Margin="0,6" SelectionChanged="Account_Changed" ToolTip="选择 ChatGPT 账号 / 工作区"/>
    <CheckBox x:Name="UseKey" Content="使用 API Key（备用，单独计费）" Click="UseKey_Click"/>
    <DockPanel Margin="0,6"><Button DockPanel.Dock="Right" Content="保存 Key" Click="SaveKey_Click"/><Button DockPanel.Dock="Right" Content="清除" Click="ClearKey_Click"/><PasswordBox Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" Padding="8,6" x:Name="ApiKeyBox" ToolTip="API Key 以 Windows 当前用户身份加密保存" MinWidth="60"/></DockPanel>
    <DockPanel><Button DockPanel.Dock="Right" Content="刷新模型" Click="Models_Click"/><ComboBox x:Name="Models" SelectionChanged="Model_Changed" ToolTip="从当前账号读取可用模型"/></DockPanel>
    <TextBlock x:Name="AccountStatus" TextWrapping="Wrap" Margin="0,6" Foreground="{DynamicResource Muted}"/>
   </StackPanel>
  </Expander>
  <WrapPanel Grid.Row="1" Margin="0,8"><Button Content="＋ 问题" Click="Add_Click"/><Button Content="全选" Click="SelectAll_Click"/><Button Content="清除已完成" Click="ClearDone_Click"/></WrapPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="在源码或 PDF 中右键收集选区，在这里填写问题并勾选。提交后会发送选区，并允许 AI 只读检索当前项目源码（含未保存修改）。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <ItemsControl x:Name="Entries">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
       <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="×" Padding="6,0" Click="Remove_Click" ToolTip="删除此条目"/><CheckBox Content="{Binding Title}" IsChecked="{Binding Selected, Mode=TwoWay}" Click="Entry_Changed" VerticalContentAlignment="Center"/></DockPanel>
        <TextBlock Text="{Binding State}" Foreground="{DynamicResource Muted}" Margin="0,5"/>
        <Expander Header="查看选区"><StackPanel>
         <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding File}" TextWrapping="Wrap"/><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <ItemsControl ItemsSource="{Binding PdfBlocks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Page, StringFormat=PDF 第 {0} 页}"/><Image Loaded="Thumbnail_Loaded" Stretch="Uniform" MaxHeight="150"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Expander>
        <TextBox Text="{Binding Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Question_Changed" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" ToolTip="描述要问的问题"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="回答记录" FontWeight="SemiBold" Margin="0,10"/>
    <TextBox x:Name="Transcript" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" AcceptsReturn="True" MinHeight="100"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="3" Margin="0,8,0,0">
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,6" Text="问题保存在本机，尚未发送。"/>
   <WrapPanel><Button x:Name="SubmitButton" Content="提交勾选问题" Click="Submit_Click"/><Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False"/></WrapPanel>
  </StackPanel>
 </Grid>
</UserControl>
