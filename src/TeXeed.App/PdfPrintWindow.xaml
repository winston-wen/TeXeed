<Window x:Class="TeXeed.App.PdfPrintWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="打印" Style="{StaticResource {x:Type Window}}" Width="1160" Height="810" MinWidth="850" MinHeight="610" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,5,14,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><StackPanel Orientation="Horizontal"><Grid Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource SidebarBackground}" Stroke="{DynamicResource Muted}"/><Ellipse x:Name="Dot" Margin="4" Fill="{DynamicResource Accent}" Visibility="Hidden"/></Grid><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource SidebarBackground}" Padding="14,8"><ContentPresenter x:Name="HeaderText" ContentSource="Header" TextElement.Foreground="{DynamicResource Ink}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="{DynamicResource SidebarBackground}" Padding="20,14">
   <Grid x:Name="PrinterSettings"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="打印机" VerticalAlignment="Center"/><ComboBox x:Name="PrinterBox" Grid.Column="2" MinWidth="150" SelectionChanged="Printer_Changed" AutomationProperties.Name="打印机"/><Button x:Name="PropertiesButton" Grid.Column="3" Content="打印机属性…" Margin="12,0,0,0" Click="Properties_Click" IsEnabled="False"/>
    <TextBlock Text="份　数" Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0"/>
    <WrapPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,12,0,0" VerticalAlignment="Center"><TextBox x:Name="CopiesInput" Text="1" Width="70" TextChanged="Option_Changed" AutomationProperties.Name="打印份数"/><CheckBox x:Name="CollateCheck" Content="逐份打印" IsChecked="True" Margin="18,0,18,0" VerticalAlignment="Center" Checked="Option_Changed" Unchecked="Option_Changed"/><CheckBox x:Name="GrayCheck" Content="灰度打印" Margin="0,0,18,0" VerticalAlignment="Center" Checked="Option_Changed" Unchecked="Option_Changed"/><CheckBox Content="省墨（由驱动控制）" IsEnabled="False" VerticalAlignment="Center"/></WrapPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.16*" MinWidth="415"/><ColumnDefinition Width="*" MinWidth="310"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SettingsBar" Margin="20,14" IsEnabled="False">
    <TextBlock Text="页码范围" Style="{StaticResource Heading}"/>
    <WrapPanel><RadioButton x:Name="AllRange" Content="全部" GroupName="Range" IsChecked="True" Checked="Option_Changed"/><RadioButton x:Name="CurrentRange" Content="当前页" GroupName="Range" Checked="Option_Changed"/><StackPanel Orientation="Horizontal" Margin="0,0,14,0"><RadioButton x:Name="CustomRange" Content="指定页" GroupName="Range" Checked="Option_Changed"/><TextBox x:Name="RangeInput" Text="1" Width="130" TextChanged="Range_Changed" AutomationProperties.Name="指定页码范围" ToolTip="例如 1, 3, 5-8；也支持 8-5 的逆向范围"/></StackPanel><RadioButton x:Name="ViewRange" GroupName="Range" Content="当前视图区域" Checked="Option_Changed" ToolTip="只打印打开此窗口前，阅读区当前页中可见的局部。"/></WrapPanel>
    <Grid Margin="0,8,0,14"><Rectangle Stroke="{DynamicResource Muted}" StrokeDashArray="4,3" StrokeThickness="1" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/><StackPanel Margin="10,5"><WrapPanel x:Name="ParityOptions"><RadioButton x:Name="AllParity" Content="不分奇偶" GroupName="Parity" IsChecked="True" Checked="Option_Changed"/><RadioButton x:Name="OddParity" Content="奇数页" GroupName="Parity" Checked="Option_Changed"/><RadioButton x:Name="EvenParity" Content="偶数页" GroupName="Parity" Checked="Option_Changed"/><CheckBox x:Name="ReverseCheck" Content="逆序打印" Margin="0,5,14,5" VerticalAlignment="Center" Checked="Option_Changed" Unchecked="Option_Changed"/></WrapPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="64"><TextBlock x:Name="ActualPagesLabel" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,5" ToolTipService.ShowDuration="30000"/></ScrollViewer></StackPanel></Grid>
    <TextBlock Text="版式与缩放" Style="{StaticResource Heading}"/>
    <TabControl x:Name="LayoutTabs" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}" SelectionChanged="LayoutMode_Changed" Padding="0,10,0,0">
     <TabItem Header="单页"><StackPanel><UniformGrid Columns="2"><RadioButton x:Name="FitScale" GroupName="Scale" Content="适合可打印区域" IsChecked="True" Checked="Option_Changed"/><RadioButton x:Name="ActualScale" GroupName="Scale" Content="实际大小" Checked="Option_Changed"/><RadioButton x:Name="ShrinkScale" GroupName="Scale" Content="仅缩小大页" Checked="Option_Changed"/><RadioButton x:Name="CustomScale" GroupName="Scale" Content="自定义倍率" Checked="Option_Changed"/></UniformGrid><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="输入后即时预览" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBox x:Name="CustomScaleInput" Grid.Column="1" Text="100.00" TextAlignment="Right" GotKeyboardFocus="Scale_Focus" TextChanged="Option_Changed" PreviewMouseWheel="Scale_Wheel" AutomationProperties.Name="自定义打印倍率" ToolTip="点入后滚轮每格 1%；Shift+滚轮每格 0.1%"/><TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0"/><Button Grid.Column="3" Content="↻" FontSize="18" Padding="9,2" Click="Refresh_Click" ToolTip="刷新预览，保留当前设置" AutomationProperties.Name="刷新打印预览"/></Grid></StackPanel></TabItem>
     <TabItem Header="每张多页"><StackPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="每张页数" Width="85" VerticalAlignment="Center"/><ComboBox x:Name="NUpBox" SelectedIndex="1" SelectionChanged="Option_Changed" AutomationProperties.Name="每张页数"><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="9"/><ComboBoxItem Content="16"/></ComboBox></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="排列顺序" Width="85" VerticalAlignment="Center"/><ComboBox x:Name="OrderBox" SelectedIndex="0" SelectionChanged="Option_Changed"><ComboBoxItem Content="从左到右，再向下"/><ComboBoxItem Content="从上到下，再向右"/></ComboBox></DockPanel><CheckBox x:Name="PageBorderCheck" Content="绘制页边框" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/></StackPanel></TabItem>
     <TabItem Header="小册子"><StackPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="装订方向" Width="85" VerticalAlignment="Center"/><ComboBox x:Name="BindingBox" SelectedIndex="0" SelectionChanged="Option_Changed"><ComboBoxItem Content="左侧装订"/><ComboBoxItem Content="右侧装订"/></ComboBox></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="打印面" Width="85" VerticalAlignment="Center"/><ComboBox x:Name="BookletSideBox" SelectedIndex="0" SelectionChanged="Option_Changed"><ComboBoxItem Content="正反两面"/><ComboBoxItem Content="仅正面"/><ComboBoxItem Content="仅背面"/></ComboBox></DockPanel><TextBlock Text="按装订顺序拼版；不足 4 页时补空白。" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></TabItem>
     <TabItem Header="海报"><StackPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="拼接倍率 (%)" Width="100" VerticalAlignment="Center"/><TextBox x:Name="PosterScaleInput" Text="180" TextChanged="Option_Changed"/></DockPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="重叠边 (mm)" Width="100" VerticalAlignment="Center"/><TextBox x:Name="OverlapInput" Text="5" TextChanged="Option_Changed"/></DockPanel><CheckBox x:Name="CutMarksCheck" Content="绘制拼接辅助线" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/></StackPanel></TabItem>
    </TabControl>
    <DockPanel Margin="0,12,0,0"><TextBlock Text="方向" Width="55" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><ComboBox x:Name="OrientationBox" SelectedIndex="0" SelectionChanged="Option_Changed" AutomationProperties.Name="纸张方向"><ComboBoxItem Content="自动"/><ComboBoxItem Content="纵向"/><ComboBoxItem Content="横向"/></ComboBox></DockPanel><TextBlock x:Name="ScaleResultLabel" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,14" TextWrapping="Wrap"/>
    <TextBlock Text="输出选项" Style="{StaticResource Heading}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="双面方式" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="DuplexBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="Option_Changed" AutomationProperties.Name="双面方式"><ComboBoxItem Content="单面" Tag="none"/><ComboBoxItem Content="手动 · 长边" Tag="manual-long"/><ComboBoxItem Content="手动 · 短边" Tag="manual-short"/></ComboBox><TextBlock Grid.Column="2" Text="打印内容" VerticalAlignment="Center" Margin="12,0,8,0"/><ComboBox x:Name="ContentBox" Grid.Column="3" SelectedIndex="0" SelectionChanged="Option_Changed" AutomationProperties.Name="打印内容"><ComboBoxItem Content="文档与批注"/><ComboBoxItem Content="仅文档"/><ComboBoxItem Content="仅批注"/></ComboBox></Grid><CheckBox x:Name="SourcePaperCheck" Content="按 PDF 页面尺寸选择纸张" Margin="0,10,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Background="{DynamicResource PreviewBackground}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="16,14,16,4"><TextBlock Text="打印预览" Style="{StaticResource Heading}" Margin="0,0,12,6"/><TextBlock x:Name="PaperInfoLabel" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></WrapPanel><ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" SizeChanged="Preview_SizeChanged"><Viewbox x:Name="SheetView" Margin="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="Sheet_MouseDown" ToolTip="双击打开独立打印预览"><Canvas x:Name="Sheet" Background="White" Width="794" Height="1123" ClipToBounds="True"><Image x:Name="PageImage" Stretch="Fill"/><Rectangle x:Name="PrintableGuide" Stroke="#777777" StrokeThickness="0.8" StrokeDashArray="4,4" IsHitTestVisible="False"/></Canvas></Viewbox></ScrollViewer><TextBlock x:Name="PreviewWarning" Grid.Row="2" Foreground="{DynamicResource Accent}" Margin="16,4" TextWrapping="Wrap"/><WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="8,6,8,12"><Button x:Name="PreviousButton" Content="‹" Padding="10,4" Click="Previous_Click" AutomationProperties.Name="上一个输出面"/><TextBox x:Name="PageInput" Width="48" Text="1" TextAlignment="Center" Padding="4" PreviewKeyDown="Page_KeyDown" LostKeyboardFocus="Page_LostFocus" AutomationProperties.Name="打印预览页码"/><TextBlock x:Name="PageCountLabel" VerticalAlignment="Center" Margin="6,0"/><Button x:Name="NextButton" Content="›" Padding="10,4" Click="Next_Click" AutomationProperties.Name="下一个输出面"/><Button Content="−" Click="ZoomOut_Click" Padding="8,4" AutomationProperties.Name="缩小查看"/><Button Content="适合窗口" Click="AutoZoom_Click" Padding="8,4"/><Button Content="+" Click="ZoomIn_Click" Padding="8,4" AutomationProperties.Name="放大查看"/></WrapPanel></Grid></Border>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource SidebarBackground}" Padding="16,6"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CancelPrintButton" Content="取消提交" Visibility="Collapsed" Click="CancelPrint_Click"/><Button Content="取消" IsCancel="True" Click="Close_Click"/><Button x:Name="PrintButton" Content="打印" MinWidth="85" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Print_Click"/></StackPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="PageSetupButton" Content="页面设置…" Click="PageSetup_Click"/><Button x:Name="AdvancedButton" Content="高级设置…" Click="Advanced_Click"/></StackPanel><TextBlock x:Name="StatusLabel" Text="正在打开 PDF…" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}"/></DockPanel></Border>
 </Grid>
</Window>
