<Window x:Class="TeXeed.App.PdfPrintWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PDF 打印预览" Style="{StaticResource {x:Type Window}}" Width="980" Height="800" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_KeyDown">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12">
   <StackPanel>
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CancelPrintButton" Content="取消打印" Visibility="Collapsed" Click="CancelPrint_Click"/><Button x:Name="PrintButton" Content="打印…" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Print_Click" ToolTip="选择打印机、页码范围、份数及双面设置 · Ctrl+P"/></StackPanel>
     <TextBlock x:Name="DocumentTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
    </DockPanel>
    <WrapPanel x:Name="SettingsBar" Margin="0,12,0,0" IsEnabled="False">
     <TextBlock Text="纸张" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <ComboBox x:Name="PaperBox" Width="108" SelectedIndex="0" SelectionChanged="Settings_Changed" AutomationProperties.Name="打印纸张"><ComboBoxItem Content="A4" Tag="ISOA4"/><ComboBoxItem Content="A3" Tag="ISOA3"/><ComboBoxItem Content="Letter" Tag="NorthAmericaLetter"/></ComboBox>
     <ComboBox x:Name="OrientationBox" Width="80" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Settings_Changed" AutomationProperties.Name="纸张方向"><ComboBoxItem Content="纵向"/><ComboBoxItem Content="横向"/></ComboBox>
     <ComboBox x:Name="ScaleBox" Width="156" Margin="8,0,12,0" SelectedIndex="0" SelectionChanged="Settings_Changed" AutomationProperties.Name="打印缩放"><ComboBoxItem Content="适合可打印区域"/><ComboBoxItem Content="实际大小 (100%)"/></ComboBox>
     <Button x:Name="PreviousButton" Content="‹" Padding="10,4" Click="Previous_Click" ToolTip="上一页" AutomationProperties.Name="打印预览上一页"/>
     <TextBox x:Name="PageInput" Width="54" Text="1" TextAlignment="Center" Padding="4" PreviewKeyDown="Page_KeyDown" LostKeyboardFocus="Page_LostFocus" AutomationProperties.Name="打印预览页码"/>
     <TextBlock x:Name="PageCountLabel" VerticalAlignment="Center" Margin="6,0"/>
     <Button x:Name="NextButton" Content="›" Padding="10,4" Click="Next_Click" ToolTip="下一页" AutomationProperties.Name="打印预览下一页"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource PreviewBackground}">
   <Viewbox x:Name="SheetView" Margin="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
    <Canvas x:Name="Sheet" Background="White" Width="794" Height="1123" ClipToBounds="True">
     <Image x:Name="PageImage" Stretch="Fill"/>
     <Rectangle x:Name="PrintableGuide" Stroke="#888888" StrokeThickness="0.8" StrokeDashArray="4,4" IsHitTestVisible="False"/>
    </Canvas>
   </Viewbox>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,8">
   <StackPanel><TextBlock x:Name="StatusLabel" Text="正在打开 PDF…" TextWrapping="Wrap"/><TextBlock Text="原始 PDF · 白纸原色 · 虚线表示可打印范围（不会印出）；最终范围以所选打印机为准。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
  </Border>
 </Grid>
</Window>
