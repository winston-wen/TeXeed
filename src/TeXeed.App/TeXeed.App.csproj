<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TeXeed</AssemblyName>
    <RootNamespace>TeXeed.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.14</Version>
    <Description>A native Windows LaTeX workspace</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TeXeed.Core/TeXeed.Core.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="PDFiumCore" Version="155.0.8057" />
  </ItemGroup>
</Project>
