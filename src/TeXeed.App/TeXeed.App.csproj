<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TeXeed</AssemblyName>
    <RootNamespace>TeXeed.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.3.31</Version>
    <ApplicationIcon>Assets/TeXeed.ico</ApplicationIcon>
    <Description>A native Windows LaTeX workspace</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/TeXeed.ico" />
    <Resource Include="Assets/TeXeed.png" />
    <EmbeddedResource Include="Assets/Tutorial/*.svg" />
    <Content Include="Themes/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Themes/README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Themes/*.json" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <ProjectReference Include="../TeXeed.Core/TeXeed.Core.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="PDFiumCore" Version="155.0.8057" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>
</Project>
