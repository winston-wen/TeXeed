<Window x:Class="TeXeed.App.AiHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI 历史对话" Width="560" Height="540" MinWidth="360" MinHeight="320" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="历史对话" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="Search_Changed" Margin="0,0,0,12" VerticalContentAlignment="Top" ToolTip="搜索标题、问题或回答" AutomationProperties.Name="搜索 AI 历史对话"/>
  <ListBox x:Name="ConversationList" Grid.Row="2" MouseDoubleClick="Conversation_DoubleClick" SelectionChanged="Selection_Changed">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="10,8" CornerRadius="5" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Selection}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3">
    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Title}"/>
    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <DockPanel Grid.Row="3" Margin="0,12,0,0">
   <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="打开" Click="Open_Click" IsEnabled="False"/>
   <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="删除对话" Click="Delete_Click" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True"/>
   <TextBlock x:Name="ResultCount" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</Window>
