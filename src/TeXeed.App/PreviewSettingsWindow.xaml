<Window x:Class="TeXeed.App.PreviewSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="预览设置" Style="{StaticResource {x:Type Window}}" Width="304" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
    <TextBlock Text="缩放倍率" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <Button Grid.Column="1" Content="−" Padding="0" Margin="0" Click="ZoomOut_Click" ToolTip="缩小"/>
    <TextBox x:Name="ZoomInput" Grid.Column="2" TextAlignment="Center" Padding="4,6" Margin="4,0" AutomationProperties.Name="PDF 缩放倍率" IsEnabled="{Binding IsChecked, ElementName=ManualZoom}" TextChanged="Input_Changed"/>
    <Button Grid.Column="3" Content="+" Padding="0" Margin="0" Click="ZoomIn_Click" ToolTip="放大"/>
   </Grid>
   <Grid Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <RadioButton x:Name="ManualZoom" Content="手动倍率" GroupName="ZoomMode" Foreground="{DynamicResource Ink}" Checked="Option_Changed"/>
    <RadioButton x:Name="AutoWidthBox" Grid.Column="1" Content="自动宽度" GroupName="ZoomMode" Foreground="{DynamicResource Ink}" Checked="Option_Changed"/>
   </Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="最大宽度" VerticalAlignment="Center"/>
    <TextBox x:Name="MaximumWidthInput" Grid.Column="1" TextAlignment="Center" Padding="4,5" AutomationProperties.Name="自动宽度上限（厘米）" IsEnabled="{Binding IsChecked, ElementName=AutoWidthBox}" TextChanged="Input_Changed"/>
    <TextBlock Grid.Column="2" Text="cm" VerticalAlignment="Center" Margin="6,0,0,0"/>
   </Grid>
   <TextBlock x:Name="PhysicalWidthHint" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
   <TextBlock Text="跟随模式" Margin="0,16,0,6"/>
   <ComboBox x:Name="FollowModeBox" DisplayMemberPath="Label" SelectedValuePath="Value" Padding="6" AutomationProperties.Name="PDF 跟随模式" SelectionChanged="Follow_Changed"/>
   <CheckBox x:Name="InvertPdfBox" Content="反色预览" Margin="0,16,0,12" ToolTip="只影响预览，导出保持原色" Checked="Option_Changed" Unchecked="Option_Changed"/>
   <CheckBox x:Name="AutoCropPdfBox" Content="自动裁边" ToolTip="横向按正文版心裁边，纵向裁去页首和页尾白边；不修改 PDF" Checked="Option_Changed" Unchecked="Option_Changed"/>
   <CheckBox x:Name="CompressWhitespaceBox" Content="压缩纵向空白" Margin="18,10,0,0" IsEnabled="{Binding IsChecked, ElementName=AutoCropPdfBox}" ToolTip="进一步压缩正文内部的大段空白，保留图表内部留白" Checked="Option_Changed" Unchecked="Option_Changed"/>
   <TextBlock x:Name="ValidationHint" Foreground="{DynamicResource Accent}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button x:Name="CancelButton" Content="取消" IsCancel="True" Click="Cancel_Click"/>
   <Button x:Name="ConfirmButton" Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Confirm_Click"/>
  </StackPanel>
 </Grid>
</Window>
