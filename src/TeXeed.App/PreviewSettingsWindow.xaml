<Window x:Class="TeXeed.App.PreviewSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="预览设置" Style="{StaticResource {x:Type Window}}" Width="430" Height="405" MinWidth="380" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="预览设置" FontSize="22" Margin="0,0,0,20"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="缩放倍率" VerticalAlignment="Center" Margin="0,0,16,0"/>
    <DockPanel Grid.Column="1"><Button Content="−" Width="30" Padding="0" Margin="0,0,4,0" Click="ZoomOut_Click" ToolTip="缩小"/><Button Content="+" Width="30" Padding="0" Margin="4,0,0,0" DockPanel.Dock="Right" Click="ZoomIn_Click" ToolTip="放大"/><TextBox x:Name="ZoomInput" TextAlignment="Center" AutomationProperties.Name="PDF 缩放倍率" IsEnabled="{Binding IsChecked, ElementName=ManualZoom}"/></DockPanel>
   </Grid>
   <Grid Margin="0,10,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="ManualZoom" Content="手动倍率" GroupName="ZoomMode" Foreground="{DynamicResource Ink}"/><RadioButton x:Name="AutoWidthBox" Grid.Column="1" Content="自动宽度" GroupName="ZoomMode" Foreground="{DynamicResource Ink}"/></Grid>
   <TextBlock Text="跟随模式" Margin="0,0,0,6"/><ComboBox x:Name="FollowModeBox" DisplayMemberPath="Label" SelectedValuePath="Value" Padding="6" AutomationProperties.Name="PDF 跟随模式"/>
   <CheckBox x:Name="InvertPdfBox" Content="反色预览" Margin="0,16,0,10" ToolTip="只影响预览，导出保持原色"/>
   <CheckBox x:Name="AutoCropPdfBox" Content="自动裁边／压缩纵向空白" ToolTip="横向按正文版心裁边，纵向压缩大段空白；不修改 PDF"/>
   <TextBlock x:Name="ValidationHint" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,10,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="取消" IsCancel="True"/><Button x:Name="ApplyButton" Content="应用" Click="Apply_Click"/><Button Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/></StackPanel>
 </Grid>
</Window>
