  "environment": "Windows build 26300 x64, AMD Ryzen 7 5700X, .NET SDK 10.0.203, Release win-x64, isolated project and profile per process. --offscreen; WPF windows shown and laid out.",
  "protocol": "Run one process at a time. Alternate before/after order between successive pairs. clickMs or syncMs measures the synchronous UI call. idleMs includes queued work through DispatcherPriority.ApplicationIdle. uiBytes measures allocations on the dispatcher thread only. controls counts visible WPF Controls in the target turn. The lamp is an Ellipse, so it is counted separately.",
  "continuation": {
    "command": "TeXeed.AppTests.exe --ai-turn-input-only --offscreen --output <new empty directory>",
    "window": "900x740 DIP",
    "measurement": "Instrument the 0.6.12 cancellation fixture identically on both products. After earlier confirmation and retries are warm, click 确认并继续 for the text question with method-A, hold the model response, wait for request arrival then dispatcher idle. Capture before cancellation. One sample in each of five independent processes per version.",
    "reproduce": "Use bc4caa1 tests on both product source trees, apply continuation.fixturePatch to the tests via git apply and build Release -r win-x64.",
    "fixturePatch": "diff --git a/tests/TeXeed.AppTests/AiTurnInputTests.cs b/tests/TeXeed.AppTests/AiTurnInputTests.cs\nindex a346393..fcc448c 100644\n--- a/tests/TeXeed.AppTests/AiTurnInputTests.cs\n+++ b/tests/TeXeed.AppTests/AiTurnInputTests.cs\n@@ -144,8 +144,21 @@ internal static partial class Program\n             Descendants<TextBox>(shown).Single(t => !t.IsReadOnly).Text = \"method-A\";\n             var started = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);\n             server.BeforeReply = token => { started.TrySetResult(); return Task.Delay(Timeout.Infinite, token); };\n-            Click(ButtonOn(shown, \"确认并继续\"));\n+            var startButton = ButtonOn(shown, \"确认并继续\");\n+            var measureStart = System.Diagnostics.Stopwatch.GetTimestamp();\n+            var allocatedBefore = GC.GetAllocatedBytesForCurrentThread();\n+            Click(startButton);\n+            var clickMs = System.Diagnostics.Stopwatch.GetElapsedTime(measureStart).TotalMilliseconds;\n             await started.Task.WaitAsync(TimeSpan.FromSeconds(8));\n+            await host.Dispatcher.InvokeAsync(() => { }, DispatcherPriority.ApplicationIdle);\n+            var idleMs = System.Diagnostics.Stopwatch.GetElapsedTime(measureStart).TotalMilliseconds;\n+            var uiBytes = GC.GetAllocatedBytesForCurrentThread() - allocatedBefore;\n+            var runningView = Descendants<AiTurnView>(panel).Single(v => v.Turn.Id == retryId);\n+            var footer = Descendants<AiReplyStatus>(runningView).Single();\n+            var controls = Descendants<Control>(runningView).Count(c => c.IsVisible);\n+            var lamps = Descendants<System.Windows.Shapes.Ellipse>(footer).Count(e => e.IsVisible && e.ActualHeight > 0 && e.ActualWidth > 0);\n+            var isThinking = footer.IsThinking;\n+            File.WriteAllText(Path.Combine(output, \"resuming-perf.json\"), System.Text.Json.JsonSerializer.Serialize(new { clickMs, idleMs, uiBytes, controls, lamps, isThinking }));\n             Click((Button)panel.FindName(\"StopButton\"));\n             await WaitUntilAsync(() => Field(panel, \"_operation\") is null, \"Stopping confirmed reasoning did not settle.\");\n             server.BeforeReply = null; await Reload();\n",
